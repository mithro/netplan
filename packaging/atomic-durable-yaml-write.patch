+        return FALSE;
+    }
+    output = fdopen(out_fd, "wb");
+    if (!output) {
+        g_set_error(error, NETPLAN_FILE_ERROR, errno, "%m");
+        close(out_fd);
+        unlink(tmp_path);
+        return FALSE;
+    }
 
     YAML_OUT_START(event, emitter, output);
     /* build the netplan boilerplate YAML structure */
@@ -1017,14 +1051,33 @@ netplan_netdef_write_yaml(
 
